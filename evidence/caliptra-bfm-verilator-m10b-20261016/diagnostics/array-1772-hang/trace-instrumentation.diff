--- overlay/axi_if.sv
+++ diagnostics/array-1772-hang/axi_if.trace.sv
@@ -165,6 +165,55 @@
     );
 
     // synopsys translate_off
+
+    `ifdef VERILATOR
+    bit m10b_trace_active = 0;
+    bit m10b_trace_b_done = 0;
+    int unsigned m10b_trace_event = 0;
+    int unsigned m10b_trace_sample = 0;
+    clocking m10b_trace_cb @(posedge clk);
+        input #1step awaddr, awvalid, awready;
+        input #1step wdata, wstrb, wlast, wvalid, wready;
+        input #1step bresp, bvalid, bready;
+    endclocking
+    always @(awaddr or awvalid or awready or wvalid or wready or bvalid or bready) begin
+        if (!m10b_trace_active && rst_n && awvalid && (awaddr == AW'(32'h30030200))) begin
+            m10b_trace_active = 1;
+            m10b_trace_b_done = 0;
+            m10b_trace_event = 0;
+            m10b_trace_sample = 0;
+            $display("M10B_AW_W_B_TRACE_START time=%0t realtime=%0.6f path=%m awaddr=%h", $time, $realtime, awaddr);
+        end
+        if (m10b_trace_active) begin
+            $display("M10B_AW_W_B_TRACE_CHANGE time=%0t realtime=%0.6f event=%0d clk=%b AW=%b/%b/%h W=%b/%b/%h/%h/%b B=%b/%b/%b",
+                $time, $realtime, m10b_trace_event, clk, awvalid, awready, awaddr,
+                wvalid, wready, wdata, wstrb, wlast, bvalid, bready, bresp);
+            m10b_trace_event = m10b_trace_event + 1;
+            if (bvalid && bready && !m10b_trace_b_done) begin
+                $display("M10B_AW_W_B_TRACE_B_HANDSHAKE time=%0t realtime=%0.6f path=%m", $time, $realtime);
+                m10b_trace_b_done = 1;
+            end else if (m10b_trace_event >= 32) begin
+                $display("M10B_AW_W_B_TRACE_WINDOW_END time=%0t realtime=%0.6f path=%m", $time, $realtime);
+                m10b_trace_active = 0;
+            end
+        end
+    end
+    always @(m10b_trace_cb) begin
+        if (m10b_trace_active) begin
+            $display("M10B_AW_W_B_SAMPLE realtime=%0.6f sample=%0d AW=%b/%b/%h W=%b/%b/%h/%h/%b B=%b/%b/%b",
+                $realtime, m10b_trace_sample,
+                m10b_trace_cb.awvalid, m10b_trace_cb.awready, m10b_trace_cb.awaddr,
+                m10b_trace_cb.wvalid, m10b_trace_cb.wready, m10b_trace_cb.wdata,
+                m10b_trace_cb.wstrb, m10b_trace_cb.wlast,
+                m10b_trace_cb.bvalid, m10b_trace_cb.bready, m10b_trace_cb.bresp);
+            m10b_trace_sample = m10b_trace_sample + 1;
+            if (m10b_trace_sample >= 32) begin
+                $display("M10B_AW_W_B_TRACE_DONE time=%0t realtime=%0.6f path=%m", $time, $realtime);
+                m10b_trace_active = 0;
+            end
+        end
+    end
+    `endif
 
     // Tasks
     `ifdef VERILATOR
